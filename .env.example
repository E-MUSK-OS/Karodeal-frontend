# KaroDeal Frontend Environment Variables
NEXT_PUBLIC_API_URL=https://karodeal-backend.vercel.app/api
NEXT_PUBLIC_SOCKET_URL=https://karodeal-backend.vercel.app

# Google OAuth 2.0 Web Client ID
# Obtain from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# (e.g. 123456789-abcdefghijk.apps.googleusercontent.com)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Facebook Pixel ID
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=1416463056665279

